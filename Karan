# ========== Database Setup (Long-term Memory) ==========
def init_db():
    conn = sqlite3.connect("sunyabot_memory.db")
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS memories
                 (id INTEGER PRIMARY KEY AUTOINCREMENT, 
                  topic TEXT, info TEXT, timestamp TEXT)''')
    c.execute('''CREATE TABLE IF NOT EXISTS user_profile
                 (name TEXT, fav_color TEXT, mood_history TEXT)''')
    conn.commit()
    conn.close()

def save_memory(topic, info):
    conn = sqlite3.connect("sunyabot_memory.db")
    c = conn.cursor()
    c.execute("INSERT INTO memories (topic, info, timestamp) VALUES (?, ?, ?)",
              (topic, info, datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
    conn.commit()
    conn.close()

def recall_memory(topic):
    conn = sqlite3.connect("sunyabot_memory.db")
    c = conn.cursor()
    c.execute("SELECT info FROM memories WHERE topic LIKE ? ORDER BY id DESC LIMIT 1", ('%'+topic+'%',))
    row = c.fetchone()
    conn.close()
    return row[0] if row else None

# ========== AI Core Brain ==========
class SunyaAI:
    def __init__(self, root):
        self.root = root
        self.root.title("Sunya AI Assistant (Mega BOT)")
        self.root.geometry("800x600")
        self.root.configure(bg="#1e1e2e")

        # Translator object
        self.translator = Translator()

        # Voice Engine
        self.engine = pyttsx3.init()
        self.engine.setProperty('rate', 180)
        self.voices = self.engine.getProperty('voices')
        # Hindi voice select (if available)
        for voice in self.voices:
            if "hindi" in voice.name.lower():
                self.engine.setProperty('voice', voice.id)
                break

        # Mood / Personality
        self.moods = ["happy", "thoughtful", "excited", "calm", "funny"]
        self.current_mood = "calm"
        self.user_name = "Dost"

        # Language flags: 'en', 'hi', 'sambalpuri' (sambalpuri as placeholder)
        self.current_lang = "hi"

        # GUI Build
        self.build_interface()

        # Load memory and profile
        self.load_profile()

    def build_interface(self):
        # Header
        header = tk.Label(self.root, text="Sunya AI", font=("Helvetica", 24, "bold"), bg="#1e1e2e", fg="#cdd6f4")
        header.pack(pady=10)

        self.mood_label = tk.Label(self.root, text=f"Mood: {self.current_mood} 😊", font=("Arial", 12), bg="#1e1e2e", fg="#a6adc8")
        self.mood_label.pack()

        lang_frame = tk.Frame(self.root, bg="#1e1e2e")
        lang_frame.pack(pady=5)
        tk.Button(lang_frame, text="हिंदी", command=lambda: self.switch_lang('hi'), bg="#89b4fa", width=10).pack(side=tk.LEFT, padx=5)
        tk.Button(lang_frame, text="English", command=lambda: self.switch_lang('en'), bg="#89b4fa", width=10).pack(side=tk.LEFT, padx=5)
        tk.Button(lang_frame, text="Sambalpuri", command=lambda: self.switch_lang('sambalpuri'), bg="#89b4fa", width=10).pack(side=tk.LEFT, padx=5)

        # Chat Display
        self.chat_display = scrolledtext.ScrolledText(self.root, wrap=tk.WORD, width=80, height=20, bg="#313244", fg="#cdd6f4", font=("Arial", 11))
        self.chat_display.pack(pady=10, padx=10)

        # User Input Frame
        input_frame = tk.Frame(self.root, bg="#1e1e2e")
        input_frame.pack(pady=5)
        self.user_input = tk.Entry(input_frame, width=60, font=("Arial", 12), bg="#45475a", fg="#cdd6f4", insertbackground="white")
        self.user_input.pack(side=tk.LEFT, padx=5)
        self.user_input.bind("<Return>", lambda event: self.process_text_input())

        tk.Button(input_frame, text="Send", command=self.process_text_input, bg="#a6e3a1", width=10).pack(side=tk.LEFT, padx=5)
        tk.Button(input_frame, text="🎤 Voice", command=self.voice_input_thread, bg="#f9e2af", width=10).pack(side=tk.LEFT, padx=5)

        # Feature Buttons
        feat_frame = tk.Frame(self.root, bg="#1e1e2e")
        feat_frame.pack(pady=5)
        tk.Button(feat_frame, text="🖼 Image Gen (DALL·E)", command=self.dalle_interface, bg="#cba6f7", width=18).pack(side=tk.LEFT, padx=4)
        tk.Button(feat_frame, text="📰 News", command=self.get_news, bg="#f38ba8", width=14).pack(side=tk.LEFT, padx=4)
        tk.Button(feat_frame, text="🌦 Weather", command=self.get_weather_interface, bg="#74c7ec", width=14).pack(side=tk.LEFT, padx=4)
        tk.Button(feat_frame, text="💻 Open App", command=self.app_launcher_interface, bg="#94e2d5", width=14).pack(side=tk.LEFT, padx=4)
        tk.Button(feat_frame, text="📷 Image Recognition", command=self.scan_image, bg="#fab387", width=18).pack(side=tk.LEFT, padx=4)

        self.update_chat("Sunya: Namaste! Main aapka AI dost hoon. Bolen ya likhen.\n")

    # ---------- Multi-Language Switch ----------
    def switch_lang(self, lang):
        self.current_lang = lang
        lang_names = {'hi':'हिंदी','en':'English','sambalpuri':'Sambalpuri'}
        self.speak(f"Language changed to {lang_names[lang]}")
        self.update_chat(f"Sunya: Language set to {lang_names[lang]}\n")

    def translate_text(self, text, target_lang):
        try:
            if target_lang == 'hi':
                return self.translator.translate(text, dest='hi').text
            elif target_lang == 'en':
                return self.translator.translate(text, dest='en').text
            elif target_lang == 'sambalpuri':
                # Sambalpuri placeholder – just adds some typical words
                return text + " (Sambalpuri flavor: aau, muin, tuma)"
        except:
            return text  # fallback

    # ---------- Voice (Input/Output) ----------
    def speak(self, text):
        # TTS – automatically uses selected Hindi/English voice if available
        try:
            self.engine.say(text)
            self.engine.runAndWait()
        except:
            pass

    def listen(self):
        r = sr.Recognizer()
        with sr.Microphone() as source:
            self.update_chat("Sunya: Sun raha hoon...\n")
            r.adjust_for_ambient_noise(source)
            try:
                audio = r.listen(source, timeout=5)
                text = r.recognize_google(audio, language='hi-IN')  # Hindi by default, detect mixed
                return text
            except sr.UnknownValueError:
                return None
            except sr.RequestError:
                messagebox.showerror("Error", "Speech recognition service down")
                return None

    def voice_input_thread(self):
        threading.Thread(target=self.voice_input, daemon=True).start()

    def voice_input(self):
        cmd = self.listen()
        if cmd:
            self.user_input.delete(0, tk.END)
            self.user_input.insert(0, cmd)
            self.process_text_input()

    # ---------- Mood Sensing (Simple) ----------
    def detect_mood(self, text):
        text_lower = text.lower()
        if any(w in text_lower for w in ['haha','joke','funny','masti','हंसी']):
            self.current_mood = "funny"
        elif any(w in text_lower for w in ['sad','dukhi','bad','बुरा','गम']):
            self.current_mood = "thoughtful"
        elif any(w in text_lower for w in ['wow','amazing','जबरदस्त','कमाल']):
            self.current_mood = "excited"
        elif any(w in text_lower for w in ['hello','hi','नमस्ते','good']):
            self.current_mood = "happy"
        else:
            self.current_mood = "calm"
        self.mood_label.config(text=f"Mood: {self.current_mood} {self.mood_emoji()}")

    def mood_emoji(self):
        return {'happy':'😊','thoughtful':'🤔','excited':'🤩','calm':'😌','funny':'😄'}.get(self.current_mood,"")

    # ---------- Core AI Processing ----------
    def process_text_input(self):
        user_text = self.user_input.get().strip()
        if not user_text:
            return
        self.user_input.delete(0, tk.END)
        self.update_chat(f"You: {user_text}\n")
        self.detect_mood(user_text)

        # Multilingual response
        lang = self.current_lang
        response = self.brain_respond(user_text, lang)

        # Speak and display
        if response:
            translated_resp = self.translate_text(response, lang)
            self.speak(translated_resp)
            self.update_chat(f"Sunya: {translated_resp}\n")
            # Save to memory
            save_memory(f"user_input_{datetime.datetime.now()}", user_text)
            save_memory(f"response_{datetime.datetime.now()}", translated_resp)

    def brain_respond(self, user_text, lang):
        user_lower = user_text.lower()

        # --- App Launcher (Digital Hand) ---
        if "open" in user_lower or "khol" in user_lower or "launch" in user_lower:
            if "notepad" in user_lower:
                os.system("notepad")
                return "Notepad khol diya."
            if "calculator" in user_lower or "calc" in user_lower:
                os.system("calc")
                return "Calculator shuru kar diya."
            if "browser" in user_lower or "chrome" in user_lower:
                webbrowser.open("https://google.com")
                return "Browser khol diya."
            # Custom app: change path accordingly
            if "spotify" in user_lower:
                os.system("start spotify")
                return "Spotify launch kar raha hoon."
            return "Konsa app kholna hai? Notepad, Calculator, Browser?"

        # --- Google Search ---
        if "google" in user_lower and "search" in user_lower:
            query = user_text.replace("google search", "").replace("Google Search", "").strip()
            if query:
                kit.search(query)
                return f"Google par '{query}' search kar raha hoon."
            else:
                return "Kya search karna hai Google par?"

        # --- Wikipedia ---
        if "wikipedia" in user_lower or "wiki" in user_lower:
            try:
                query = user_text.replace("wikipedia", "").replace("wiki", "").strip()
                wiki_wiki = wikipediaapi.Wikipedia('en')
                page = wiki_wiki.page(query)
                if page.exists():
                    summary = page.summary[0:300]
                    return f"Wikipedia se: {summary}..."
                else:
                    return f"'{query}' Wikipedia par nahi mila."
            except:
                return "Wikipedia access mein problem ho gayi."

        # --- Weather (needs WEATHER_API_KEY) ---
        if "weather" in user_lower or "mausam" in user_lower:
            return self.get_weather_quick("London")  # default city change karein

        # --- News ---
        if "news" in user_lower or "khabar" in user_lower:
            return self.fetch_news_headlines()

        # --- Time / Date ---
        if "time" in user_lower or "samay" in user_lower:
            now = datetime.datetime.now().strftime("%I:%M %p")
            return f"Abhi samay hai {now}"
        if "date" in user_lower or "tarikh" in user_lower:
            today = datetime.datetime.now().strftime("%d %B, %Y")
            return f"Aaj tarikh hai {today}"

        # --- Calculations ---
        if any(op in user_lower for op in ['+','-','*','/','%','square']):
            try:
                expr = user_text.replace(" ", "")  # basic safety: eval with numbers only
                # Restrict to simple math using py_expression_eval or safe eval
                result = eval(expr, {"__builtins__": {}})
                return f"Calculation result: {result}"
            except:
                return "Calculation mein kuch gadbad hai."

        # --- Memory Recall ---
        if "yaad" in user_lower or "recall" in user_lower:
            topic = user_text.replace("yaad", "").replace("recall", "").strip()
            mem = recall_memory(topic)
            if mem:
                return f"Mujhe yaad hai: {mem}"
            else:
                return f"{topic} ke baare mein kuch yaad nahi."

        # --- Mood-based reply ---
        if "mood" in user_lower:
            return f"Mera mood abhi {self.current_mood} hai."

        # --- DALL·E prompt gateway (will be handled by button interface) ---
        # Not triggered by text unless specific command
        if "generate image" in user_lower or "create image" in user_lower:
            prompt = user_text.replace("generate image", "").replace("create image", "").strip()
            if prompt:
                self.generate_image(prompt)
                return "Image generate karne ki koshish kar raha hoon. GUI check karo."
            else:
                return "Kis chiz ki image banani hai?"

        # --- ChatGPT fallback ---
        # Only use if OpenAI key available, else smart local response
        if OPENAI_API_KEY != "your-openai-api-key":
            try:
                return self.chatgpt_reply(user_text)
            except:
                pass
        # Local AI response (mood based)
        mood_responses = {
            "happy": ["Aaj to maza aa raha hai!", "Badiya! Aur sunao?"],
            "thoughtful": ["Lagta hai kuch soch rahe ho...", "Main hoon na, batao kya hua."],
            "excited": ["Wah! Yeh to kamal hai!", "Mujhe bhi energy mil gayi!"],
            "funny": ["Chalo hasi mazak karte hain! 😄", "Ek aur joke sunao!"],
            "calm": ["Main hamesha yahan hoon."],
        }
        return random.choice(mood_responses.get(self.current_mood, ["Samjha nahi."]))

    # ========== ChatGPT Integration ==========
    def chatgpt_reply(self, prompt):
        openai.api_key = OPENAI_API_KEY
        response = openai.ChatCompletion.create(
            model="gpt-3.5-turbo",
            messages=[{"role": "user", "content": prompt}]
        )
        return response.choices[0].message.content.strip()

    # ========== DALL·E Image Generation ==========
    def generate_image(self, prompt):
        if OPENAI_API_KEY == "your-openai-api-key":
            messagebox.showinfo("Info", "OpenAI API key daaliye.")
            return
        openai.api_key = OPENAI_API_KEY
        try:
            response = openai.Image.create(prompt=prompt, n=1, size="512x512")
            image_url = response['data'][0]['url']
            # Show image in new window
            img_window = tk.Toplevel(self.root)
            img_window.title("DALL·E Generated Image")
            import urllib.request
            with urllib.request.urlopen(image_url) as u:
                raw_data = u.read()
            image = Image.open(io.BytesIO(raw_data))
            photo = ImageTk.PhotoImage(image)
            label = tk.Label(img_window, image=photo)
            label.image = photo
            label.pack()
        except Exception as e:
            messagebox.showerror("Error", f"Image gen failed: {e}")

    def dalle_interface(self):
        prompt = tk.simpledialog.askstring("DALL·E", "Image prompt likhiye:")
        if prompt:
            threading.Thread(target=lambda: self.generate_image(prompt)).start()

    # ========== News ==========
    def fetch_news_headlines(self):
        if NEWS_API_KEY == "your-newsapi-key":
            return "News feature ke liye API key set karein."
        try:
            newsapi = NewsApiClient(api_key=NEWS_API_KEY)
            top = newsapi.get_top_headlines(language='en', country='in')
            articles = top['articles'][:3]
            headlines = [f"{i+1}. {a['title']}" for i, a in enumerate(articles)]
            return "Aaj ki top khabrein:\n" + "\n".join(headlines)
        except:
            return "News nahi la paya."

    def get_news(self):
        news_text = self.fetch_news_headlines()
        self.update_chat(f"Sunya: {news_text}\n")
        self.speak(news_text)

    # ========== Weather ==========
    def get_weather_quick(self, city="London"):
        if WEATHER_API_KEY == "your-openweathermap-key":
            return "Weather API key nahi hai."
        try:
            url = f"https://api.openweathermap.org/data/2.5/weather?q={city}&appid={WEATHER_API_KEY}&units=metric"
            resp = requests.get(url).json()
            temp = resp['main']['temp']
            desc = resp['weather'][0]['description']
            return f"{city} ka mausam: {temp}°C, {desc}"
        except:
            return "Weather data nahi mila."

    def get_weather_interface(self):
        city = tk.simpledialog.askstring("Weather", "Shahar ka naam:")
        if city:
            weather = self.get_weather_quick(city)
            self.update_chat(f"Sunya: {weather}\n")
            self.speak(weather)

    # ========== App Launcher Interface ==========
    def app_launcher_interface(self):
        app = tk.simpledialog.askstring("App Launcher", "App name (Notepad, Calc, Chrome, Spotify):")
        if app:
            self.user_input.delete(0, tk.END)
            self.user_input.insert(0, f"open {app}")
            self.process_text_input()

    # ========== Image Recognition (Basic openCV + webcam) ==========
    def scan_image(self):
        # Simple webcam snapshot and shows what it sees (placeholder for real recognition)
        cap = cv2.VideoCapture(0)
        if not cap.isOpened():
            messagebox.showerror("Error", "Webcam nahi mila.")
            return
        ret, frame = cap.read()
        cap.release()
        if ret:
            # Convert to RGB and show in a window
            frame_rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            img = Image.fromarray(frame_rgb)
            img.show()  # or display in tkinter
            # Here you could integrate object detection using a pre-trained model (e.g., YOLO tiny)
            # For demo: just caption "Image captured"
            self.update_chat("Sunya: Photo capture kar li. (Image Recognition full implement karna baaki hai)\n")
        else:
            messagebox.showerror("Error", "Frame capture nahi hua.")

    # ========== Profile & Memory Helpers ==========
    def load_profile(self):
        # simple profile load
        pass

    def update_chat(self, msg):
        self.chat_display.insert(tk.END, msg)
        self.chat_display.see(tk.END)

